rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
// Regras do Firestore — projeto Firebase PRÓPRIO DA BARRAGEM: AppBarragem (appbarragem-8138e)
// App: orcamento_barragem.html (coleções barragem_orcamentos e barragem_config)
//
// NÃO publicar no "rdo-benetech" (Suzano) nem no "vulcaescala-amt" (AMT).
// Publicar SOMENTE no projeto da Barragem: Firestore Database → Regras.
//
// Os e-mails foram ocultados porque este repositório é público. Antes de
// colar no console, troque cada marcador pelo e-mail real de quem pode
// usar o app. Quem não estiver na lista consegue criar conta, mas não lê
// nem grava nenhum orçamento.
// ═══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowed() {
      return request.auth != null && request.auth.token.email in [
        '<<EMAIL_1 — responsável da Barragem>>',
        '<<EMAIL_2>>'
      ];
    }

    // Orçamentos
    match /barragem_orcamentos/{id} {
      allow read, write: if isAllowed();
    }

    // Catálogo de preços e dados da empresa
    match /barragem_config/{docId} {
      allow read, write: if isAllowed() && docId in ['catalogo', 'empresa'];
    }

    // Todo o resto fica bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
